  m_Script: {fileID: 11500000, guid: b83b58d05831ccc4db45c7c67de5e8f9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  musica: {fileID: 321823513}
  textoUI: {fileID: 1192190948}
  imagenUI: {fileID: 861666584}
  nombreEscena: laberinto
  dialogos:
  - "El cielo se cerr\xF3\u2026  \ny la tierra comenz\xF3 a morir."
  - "El hambre se extendi\xF3  \nentre el pueblo.\n"
  - "Para salvarlos,  alguien deb\xEDa ser ofrecido a Chaac el dios de la lluvia.\n"
  - "Elegida por los dioses,  \nfue guiada al cenote sagrado.\n"
  - "Sin resistencia, cay\xF3 en las profundidades\u2026\n"
  - "No solo como una muerte,  \nsino como una ofrenda."
  - Pero la muerte no fue el final
  - "Despert\xF3 en Xilbaba,  \nel reino de las pruebas y las sombras."
  - "Si quiere devolver la lluvia\u2026  \ndeber\xE1 enfrentarlo todo"
  tiempoEntreLineas: 2.3
  velocidadTexto: 0.03
  duracionFade: 1
  imagenSequia: {fileID: -1221618751, guid: aff8d6066ffe15d4ea8f7a69fabe6d90, type: 3}
  imagenSacrificio: {fileID: -1999688446, guid: f95094d56c775f94193a336f94aac4d0, type: 3}
  imagenXilbaba: {fileID: -1844134905, guid: 9ed380a84fd01ac4482fa5b8eb9a9bed, type: 3}
  cuadroDialogo: {fileID: 678973569}
  botonSaltar: {fileID: 307105393}
  panelNegro: {fileID: 406118356}
  fadeFinal: 1.5
